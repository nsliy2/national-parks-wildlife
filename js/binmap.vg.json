{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": {
    "text": "Most threatened-animal sightings fall outside the featured parks",
    "subtitle": [
      "Australia is cut into equal squares of half a degree (about 50 km); empty squares had no sightings since 2020.",
      "Only 7% of all sightings are within 50 km of the featured park. Pick an animal below; its park is circled."
    ],
    "anchor": "start",
    "fontSize": 18,
    "subtitleFontSize": 13,
    "subtitleColor": "#555"
  },
  "width": "container",
  "height": 520,
  "params": [
    {
      "name": "pick_animal",
      "value": "All 8 animals",
      "bind": {
        "input": "select",
        "name": "Threatened animal: ",
        "options": [
          "All 8 animals",
          "Koala",
          "Gang-gang Cockatoo",
          "Greater Glider",
          "Carnaby's Black-Cockatoo",
          "Southern Cassowary",
          "Yellow-footed Rock-wallaby",
          "Northern Quoll",
          "Tasmanian Devil"
        ]
      }
    },
    {
      "name": "views",
      "value": {
        "All 8 animals": [
          134,
          -27.5,
          0.8
        ],
        "Koala": [
          148.5,
          -29.0,
          1.7
        ],
        "Gang-gang Cockatoo": [
          147.3,
          -35.6,
          2.6
        ],
        "Greater Glider": [
          148.6,
          -32.2,
          1.9
        ],
        "Carnaby's Black-Cockatoo": [
          117.5,
          -32,
          3.0
        ],
        "Southern Cassowary": [
          145.3,
          -17.2,
          3.0
        ],
        "Yellow-footed Rock-wallaby": [
          139.5,
          -30.5,
          3.0
        ],
        "Northern Quoll": [
          133.0,
          -19.0,
          1.3
        ],
        "Tasmanian Devil": [
          146.6,
          -42.0,
          3.8
        ]
      }
    }
  ],
  "projection": {
    "type": "conicEqualArea",
    "parallels": [
      -18,
      -36
    ],
    "rotate": [
      -132,
      0
    ],
    "center": {
      "expr": "[views[pick_animal][0] - 132, views[pick_animal][1]]"
    },
    "scale": {
      "expr": "width * 1.05 * views[pick_animal][2]"
    }
  },
  "layer": [
    {
      "data": {
        "values": [
          {}
        ]
      },
      "mark": {
        "type": "rect",
        "fill": "#e3eef4"
      },
      "encoding": {
        "x": {
          "value": 0
        },
        "y": {
          "value": 0
        },
        "x2": {
          "value": "width"
        },
        "y2": {
          "value": "height"
        }
      }
    },
    {
      "data": {
        "url": "https://raw.githubusercontent.com/nsliy2/national-parks-wildlife/main/data/australia_states.json",
        "format": {
          "type": "topojson",
          "feature": "states"
        }
      },
      "mark": {
        "type": "geoshape",
        "fill": "#f4f1ea",
        "stroke": "#b8b8b8",
        "strokeWidth": 0.7,
        "clip": true
      }
    },
    {
      "data": {
        "graticule": {
          "extent": [
            [
              113,
              -44
            ],
            [
              154,
              -10
            ]
          ],
          "step": [
            0.5,
            0.5
          ]
        }
      },
      "mark": {
        "type": "geoshape",
        "filled": false,
        "stroke": "#cfc8b8",
        "strokeWidth": 0.4,
        "clip": true
      }
    },
    {
      "data": {
        "url": "https://raw.githubusercontent.com/nsliy2/national-parks-wildlife/main/data/threatened_sightings_grid.csv",
        "format": {
          "type": "csv",
          "parse": {
            "lat": "number",
            "lon": "number",
            "sightings": "number"
          }
        }
      },
      "transform": [
        {
          "filter": "pick_animal == 'All 8 animals' || datum.animal == pick_animal"
        },
        {
          "calculate": "floor(datum.lat / 0.5) * 0.5",
          "as": "lat0"
        },
        {
          "calculate": "floor(datum.lon / 0.5) * 0.5",
          "as": "lon0"
        },
        {
          "aggregate": [
            {
              "op": "sum",
              "field": "sightings",
              "as": "total"
            }
          ],
          "groupby": [
            "lat0",
            "lon0"
          ]
        },
        {
          "calculate": "datum.lat0 + 0.5",
          "as": "lat1"
        },
        {
          "calculate": "datum.lon0 + 0.5",
          "as": "lon1"
        },
        {
          "calculate": "datum.total < 2 ? '1' : datum.total < 10 ? '2–9' : datum.total < 50 ? '10–49' : datum.total < 250 ? '50–249' : '250+'",
          "as": "band"
        },
        {
          "calculate": "{'type': 'Feature', 'properties': {}, 'geometry': {'type': 'Polygon', 'coordinates': [[[datum.lon0, datum.lat0], [datum.lon0, datum.lat1], [datum.lon1, datum.lat1], [datum.lon1, datum.lat0], [datum.lon0, datum.lat0]]]}}",
          "as": "square"
        }
      ],
      "mark": {
        "type": "geoshape",
        "stroke": "white",
        "strokeWidth": 0.3,
        "clip": true
      },
      "encoding": {
        "color": {
          "field": "band",
          "type": "ordinal",
          "scale": {
            "domain": [
              "1",
              "2–9",
              "10–49",
              "50–249",
              "250+"
            ],
            "range": [
              "#ffffb2",
              "#fecc5c",
              "#fd8d3c",
              "#f03b20",
              "#bd0026"
            ]
          },
          "legend": {
            "title": "Sightings per square",
            "orient": "bottom-left",
            "symbolType": "square",
            "symbolSize": 180,
            "labelFontSize": 11,
            "titleFontSize": 12,
            "fillColor": "white",
            "padding": 8,
            "titleLimit": 300
          }
        },
        "tooltip": [
          {
            "field": "total",
            "type": "quantitative",
            "title": "Sightings in this square",
            "format": ","
          }
        ],
        "shape": {
          "field": "square",
          "type": "geojson"
        }
      }
    },
    {
      "data": {
        "values": [
          {
            "park": "Royal",
            "animal": "Koala",
            "lat": -34.1129,
            "lon": 151.0372
          },
          {
            "park": "Wilsons Promontory",
            "animal": "Gang-gang Cockatoo",
            "lat": -38.9573,
            "lon": 146.3515
          },
          {
            "park": "Daintree",
            "animal": "Southern Cassowary",
            "lat": -16.3669,
            "lon": 145.2479
          },
          {
            "park": "Ikara-Flinders Ranges",
            "animal": "Yellow-footed Rock-wallaby",
            "lat": -31.5107,
            "lon": 138.5685
          },
          {
            "park": "Stirling Range",
            "animal": "Carnaby's Black-Cockatoo",
            "lat": -34.3916,
            "lon": 117.8986
          },
          {
            "park": "Cradle Mountain",
            "animal": "Tasmanian Devil",
            "lat": -41.8063,
            "lon": 145.9609
          },
          {
            "park": "Kakadu",
            "animal": "Northern Quoll",
            "lat": -12.9788,
            "lon": 132.4391
          },
          {
            "park": "Namadgi",
            "animal": "Greater Glider",
            "lat": -35.5834,
            "lon": 148.9361
          }
        ]
      },
      "encoding": {
        "longitude": {
          "field": "lon",
          "type": "quantitative"
        },
        "latitude": {
          "field": "lat",
          "type": "quantitative"
        }
      },
      "layer": [
        {
          "transform": [
            {
              "filter": "pick_animal != 'All 8 animals' && datum.animal != pick_animal"
            }
          ],
          "mark": {
            "type": "circle",
            "size": 30,
            "color": "#555",
            "opacity": 0.8
          },
          "encoding": {
            "tooltip": [
              {
                "field": "park",
                "title": "Featured park"
              }
            ]
          }
        },
        {
          "transform": [
            {
              "filter": "pick_animal == 'All 8 animals' || datum.animal == pick_animal"
            }
          ],
          "mark": {
            "type": "circle",
            "size": 350,
            "fill": null,
            "stroke": "#111",
            "strokeWidth": 2.5
          },
          "encoding": {
            "tooltip": [
              {
                "field": "park",
                "title": "Featured park"
              },
              {
                "field": "animal",
                "title": "Its threatened animal"
              }
            ]
          }
        },
        {
          "transform": [
            {
              "filter": "(pick_animal == 'All 8 animals' || datum.animal == pick_animal) && datum.park != 'Namadgi'"
            }
          ],
          "mark": {
            "type": "text",
            "align": "left",
            "dx": 16,
            "dy": -12,
            "fontSize": 13,
            "fontWeight": "bold",
            "color": "#111"
          },
          "encoding": {
            "text": {
              "field": "park"
            }
          }
        },
        {
          "transform": [
            {
              "filter": "(pick_animal == 'All 8 animals' || datum.animal == pick_animal) && datum.park == 'Namadgi'"
            }
          ],
          "mark": {
            "type": "text",
            "align": "right",
            "dx": -16,
            "dy": 14,
            "fontSize": 13,
            "fontWeight": "bold",
            "color": "#111"
          },
          "encoding": {
            "text": {
              "field": "park"
            }
          }
        }
      ]
    },
    {
      "data": {
        "values": [
          {
            "animal": "All 8 animals",
            "line1": "7% of all sightings",
            "line2": "are within 50 km of the animal's featured park"
          },
          {
            "animal": "Koala",
            "line1": "9% of Koala sightings",
            "line2": "are within 50 km of Royal"
          },
          {
            "animal": "Gang-gang Cockatoo",
            "line1": "2% of Gang-gang Cockatoo sightings",
            "line2": "are within 50 km of Wilsons Promontory"
          },
          {
            "animal": "Greater Glider",
            "line1": "1% of Greater Glider sightings",
            "line2": "are within 50 km of Namadgi"
          },
          {
            "animal": "Carnaby's Black-Cockatoo",
            "line1": "6% of Carnaby's Black-Cockatoo sightings",
            "line2": "are within 50 km of Stirling Range"
          },
          {
            "animal": "Southern Cassowary",
            "line1": "26% of Southern Cassowary sightings",
            "line2": "are within 50 km of Daintree"
          },
          {
            "animal": "Yellow-footed Rock-wallaby",
            "line1": "23% of Yellow-footed Rock-wallaby sightings",
            "line2": "are within 50 km of Ikara-Flinders Ranges"
          },
          {
            "animal": "Northern Quoll",
            "line1": "0% of Northern Quoll sightings",
            "line2": "are within 50 km of Kakadu"
          },
          {
            "animal": "Tasmanian Devil",
            "line1": "17% of Tasmanian Devil sightings",
            "line2": "are within 50 km of Cradle Mountain"
          }
        ]
      },
      "transform": [
        {
          "filter": "datum.animal == pick_animal"
        }
      ],
      "layer": [
        {
          "mark": {
            "type": "text",
            "align": "right",
            "fontSize": 14,
            "fontWeight": "bold",
            "color": "#bd0026"
          },
          "encoding": {
            "x": {
              "value": {
                "expr": "width - 16"
              }
            },
            "y": {
              "value": 28
            },
            "text": {
              "field": "line1"
            }
          }
        },
        {
          "mark": {
            "type": "text",
            "align": "right",
            "fontSize": 13,
            "color": "#333"
          },
          "encoding": {
            "x": {
              "value": {
                "expr": "width - 16"
              }
            },
            "y": {
              "value": 48
            },
            "text": {
              "field": "line2"
            }
          }
        }
      ]
    }
  ],
  "config": {
    "view": {
      "stroke": null
    },
    "font": "Helvetica, Arial, sans-serif"
  }
}