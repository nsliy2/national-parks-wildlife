{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
    "title": {
    "text": "797 national parks, from tiny islands to desert giants",
    "subtitle": [
      "Each circle is one mainland or Tasmanian national park, sized by area.",
      "The 8 parks this story follows are outlined and named."
    ],
    "anchor": "start",
    "fontSize": 18,
    "subtitleFontSize": 13,
    "subtitleColor": "#555"
  },
  "width": "container",
  "height": 460,
  "projection": {
    "type": "conicEqualArea",
    "parallels": [
      -18,
      -36
    ],
    "rotate": [
      -132,
      0
    ],
    "center": [2, -27.5],
    "scale": {"expr": "min(width * 1.05, height * 1.75) * 0.82"}
  },
  "params": [
    {
      "name": "year_shown",
      "value": 2024,
      "bind": {"input": "range", "min": 1882, "max": 2024, "step": 1, "name": "Show parks declared by: "}
    }
  ],
  "layer": [
    {
      "data": {
        "values": [
          {}
        ]
      },
      "mark": {
        "type": "rect",
        "fill": "#e3eef4"
      },
      "encoding": {
        "x": {
          "value": 0
        },
        "y": {
          "value": 0
        },
        "x2": {
          "value": "width"
        },
        "y2": {
          "value": "height"
        }
      }
    },
    {
      "data": {
        "url": "https://raw.githubusercontent.com/nsliy2/national-parks-wildlife/main/data/australia_states.json",
        "format": {
          "type": "topojson",
          "feature": "states"
        }
      },
      "mark": {
        "type": "geoshape",
        "fill": "#f4f1ea",
        "stroke": "#b8b8b8",
        "strokeWidth": 0.7
      }
    },
    {
      "data": {
        "url": "https://raw.githubusercontent.com/nsliy2/national-parks-wildlife/main/data/national_parks.csv"
      },
      "transform": [
        {
          "filter": "datum.state != 'EXT'"
        },
        {
          "calculate": "toNumber(substring(datum.date_declared, 0, 4))",
          "as": "year"
        },
        {
          "aggregate": [
            {
              "op": "sum",
              "field": "area_ha",
              "as": "total_area"
            },
            {
              "op": "argmax",
              "field": "area_ha",
              "as": "largest_part"
            },
            {
              "op": "min",
              "field": "year",
              "as": "year_declared"
            }
          ],
          "groupby": [
            "pa_id",
            "name",
            "state"
          ]
        },
        {
          "calculate": "datum.largest_part.longitude",
          "as": "lon"
        },
        {
          "calculate": "datum.largest_part.latitude",
          "as": "lat"
        },
        {
          "calculate": "indexof(['CWTH_06', 'QLD_0017DAB001', 'VIC_3308', 'SA_0012', 'WA_01090', 'TAS_50238', 'ACT_39', 'NSW_N0030'], datum.pa_id) >= 0",
          "as": "featured"
        },
        {
          "calculate": "datum.name == 'Cradle Mountain-Lake St Clair' ? 'Cradle Mountain' : datum.name",
          "as": "short_name"
        },
        {
          "filter": "datum.year_declared <= year_shown"
        }
      ],
      "layer": [
        {
          "mark": {
            "type": "circle",
            "opacity": 0.55,
            "color": "#2e7d32"
          },
          "encoding": {
            "longitude": {
              "field": "lon",
              "type": "quantitative"
            },
            "latitude": {
              "field": "lat",
              "type": "quantitative"
            },
            "size": {
              "field": "total_area",
              "type": "quantitative",
              "title": "Park area",
              "scale": {
                "domain": [0, 3700000],
                "range": [4, 1500]
              },
              "legend": {
                "values": [
                  100000,
                  1000000,
                  3000000
                ],
                "format": ",.0f",
                "labelExpr": "datum.label + ' hectares'",
                "orient": "bottom-left",
                "fillColor": "rgba(255,255,255,0.85)",
                "padding": 8,
                "titleLimit": 300
              }
            },
            "stroke": {
              "condition": {
                "test": "datum.featured",
                "value": "#1b1b1b"
              },
              "value": null
            },
            "strokeWidth": {
              "condition": {
                "test": "datum.featured",
                "value": 2
              },
              "value": 0
            },
            "tooltip": [
              {
                "field": "name",
                "type": "nominal",
                "title": "National park"
              },
              {
                "field": "state",
                "type": "nominal",
                "title": "State or territory"
              },
              {
                "field": "total_area",
                "type": "quantitative",
                "title": "Area (hectares)",
                "format": ",.0f"
              },
              {
                "field": "year_declared",
                "type": "quantitative",
                "title": "First declared",
                "format": "d"
              }
            ]
          }
        },
        {
          "transform": [
            {
              "filter": "datum.featured"
            }
          ],
          "mark": {
            "type": "text",
            "align": "left",
            "dx": 9,
            "dy": -6,
            "fontSize": 12,
            "fontWeight": "bold",
            "color": "#1b1b1b"
          },
          "encoding": {
            "longitude": {
              "field": "lon",
              "type": "quantitative"
            },
            "latitude": {
              "field": "lat",
              "type": "quantitative"
            },
            "text": {
              "field": "short_name",
              "type": "nominal"
            }
          }
        }
      ]
    },
    {
      "data": {"values": [
        {"lon": 137.29, "lat": -26.79, "lon2": 130.5, "lat2": -35.6},
        {"lon": 151.3, "lat": -23.5, "lon2": 155.2, "lat2": -23.5}
      ]},
      "transform": [{"filter": "year_shown >= 2024"}],
      "mark": {"type": "rule", "color": "#333", "strokeWidth": 1},
      "encoding": {
        "longitude": {"field": "lon", "type": "quantitative"},
        "latitude": {"field": "lat", "type": "quantitative"},
        "longitude2": {"field": "lon2"},
        "latitude2": {"field": "lat2"}
      }
    },
    {
      "data": {"values": [{"lon": 130.5, "lat": -35.6, "t": ["Largest: Munga-Thirri–Simpson Desert,", "3.6 million hectares"]}]},
      "transform": [{"filter": "year_shown >= 2024"}],
      "mark": {"type": "text", "baseline": "top", "align": "center", "dy": 3, "fontSize": 11, "color": "#333", "lineHeight": 14},
      "encoding": {
        "longitude": {"field": "lon", "type": "quantitative"},
        "latitude": {"field": "lat", "type": "quantitative"},
        "text": {"field": "t"}
      }
    },
    {
      "data": {"values": [{"lon": 155.4, "lat": -23.5, "t": ["212 of Queensland's 320", "parks are under 10,000 hectares,", "including about 40 islands"]}]},
      "transform": [{"filter": "year_shown >= 2024"}],
      "mark": {"type": "text", "baseline": "middle", "align": "left", "fontSize": 11, "color": "#333", "lineHeight": 14},
      "encoding": {
        "longitude": {"field": "lon", "type": "quantitative"},
        "latitude": {"field": "lat", "type": "quantitative"},
        "text": {"field": "t"}
      }
    },
    {
      "data": {
        "url": "https://raw.githubusercontent.com/nsliy2/national-parks-wildlife/main/data/national_parks.csv"
      },
      "transform": [
        {"filter": "datum.state != 'EXT'"},
        {"calculate": "toNumber(substring(datum.date_declared, 0, 4))", "as": "year"},
        {"aggregate": [{"op": "min", "field": "year", "as": "year_declared"}], "groupby": ["pa_id"]},
        {"filter": "datum.year_declared <= year_shown"},
        {"aggregate": [{"op": "count", "as": "n"}]},
        {"calculate": "format(datum.n, ',') + ' national parks by ' + year_shown", "as": "line1"}
      ],
      "mark": {"type": "text", "align": "right", "fontSize": 15, "fontWeight": "bold", "color": "#2e7d32"},
      "encoding": {
        "x": {"value": {"expr": "width - 16"}},
        "y": {"value": 26},
        "text": {"field": "line1"}
      }
    }
  ],
  "config": {
    "view": {
      "stroke": null
    },
    "font": "'Source Sans 3', Helvetica, Arial, sans-serif"
  }
}