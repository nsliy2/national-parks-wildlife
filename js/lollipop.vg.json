{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "data": {
    "url": "https://raw.githubusercontent.com/nsliy2/national-parks-wildlife/main/data/speciesbypark.csv",
    "format": {
      "type": "csv",
      "parse": {
        "species_count": "number"
      }
    }
  },
  "transform": [
    {
      "pivot": "animal_group",
      "value": "species_count",
      "groupby": [
        "park",
        "state"
      ]
    },
    {
      "calculate": "datum['All animals'] - (datum.Birds + datum.Mammals + datum.Reptiles + datum.Amphibians + datum.Fishes + datum.Insects)",
      "as": "Other animals"
    },
    {
      "calculate": "(datum.park == 'Cradle Mountain-Lake St Clair' ? 'Cradle Mountain' : datum.park) + ' (' + {'New South Wales':'NSW','Victoria':'Vic','Queensland':'Qld','South Australia':'SA','Western Australia':'WA','Tasmania':'Tas','Northern Territory':'NT','Australian Capital Territory':'ACT'}[datum.state] + ')'",
      "as": "park_label"
    }
  ],
  "config": {
    "view": {
      "stroke": null
    },
    "font": "'Source Sans 3', Helvetica, Arial, sans-serif"
  },
  "title": {
    "text": "Royal, beside Sydney, has about 13 times more recorded species than Kakadu",
    "subtitle": [
      "Animal species and subspecies recorded by ALA within 10 km of each featured park's centre point.",
      "Parks near cities get far more visitors recording sightings, so they look richer than remote parks."
    ],
    "anchor": "start",
    "fontSize": 18,
    "subtitleFontSize": 13,
    "subtitleColor": "#555"
  },
  "width": "container",
  "height": {
    "step": 34
  },
  "encoding": {
    "y": {
      "field": "park_label",
      "type": "nominal",
      "sort": {
        "field": "All animals",
        "op": "max",
        "order": "descending"
      },
      "title": null,
      "axis": {
        "labelFontSize": 12,
        "labelLimit": 320,
        "domain": false,
        "ticks": false
      }
    },
    "x": {
      "field": "All animals",
      "type": "quantitative",
      "title": "Animal species recorded",
      "axis": {
        "format": ",d",
        "grid": true,
        "gridColor": "#eee",
        "titleFontSize": 12
      }
    }
  },
  "layer": [
    {
      "mark": {
        "type": "rule",
        "color": "#9e9e9e",
        "strokeWidth": 2
      },
      "encoding": {
        "x": {
          "datum": 0
        },
        "x2": {
          "field": "All animals"
        }
      }
    },
    {
      "mark": {
        "type": "circle",
        "size": 160,
        "color": "#2e7d32",
        "opacity": 1
      },
      "encoding": {
        "tooltip": [
          {
            "field": "park_label",
            "title": "Park"
          },
          {
            "field": "All animals",
            "type": "quantitative",
            "title": "Animal species",
            "format": ","
          }
        ]
      }
    },
    {
      "mark": {
        "type": "text",
        "align": "left",
        "dx": 10,
        "fontSize": 12,
        "color": "#222"
      },
      "encoding": {
        "text": {
          "field": "All animals",
          "type": "quantitative",
          "format": ","
        }
      }
    }
  ]
}